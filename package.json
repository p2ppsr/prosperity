{
  "name": "babbage-os",
  "version": "1.0.0",
  "private": false,
  "description": "A BRC-100 native personal computing environment for the web.",
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build:frontend": "vite build",
    "verify": "npm run check && npm test && npm run build:frontend",
    "stage:cars": "rm -rf frontend && cp -R build frontend",
    "build": "npm run build:frontend && npm run stage:cars && cars build Babbage",
    "deploy": "cars release now Babbage"
  },
  "dependencies": {
    "@bsv/sdk": "2.4.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-rnd": "^10.5.2"
  },
  "devDependencies": {
    "@p2ppsr/cars-cli": "^1.2.32",
    "@p2ppsr/lars": "^1.5.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "^29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
